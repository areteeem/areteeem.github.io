---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/global.css";
import { projects } from "../data/projects";
---

<BaseLayout title="Artem | Product, engineering, and research" description="Artem designs and builds systems for how people learn, reason, and work.">
  <a class="skip" href="#content">Skip to content</a>
  <header class="site-header" data-header>
    <nav class="page nav" aria-label="Primary navigation">
      <a class="mark" href="#top" aria-label="Artem, home">artem.</a>
      <div class="nav-links">
        <a class="nav-link" href="#work">Work</a>
        <a class="nav-link" href="#about">About</a>
        <a class="nav-link" href="#research">Research</a>
        <a class="nav-link" href="https://github.com/areteeem">GitHub</a>
      </div>
    </nav>
  </header>

  <main id="content">
    <div class="page" id="top">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-copy">
          <div class="eyebrow" data-hero-meta>Product · Engineering · Research</div>
          <h1 id="hero-title" data-hero-title>I design and build systems for how people learn, reason, and work.</h1>
          <p data-hero-copy>Product-minded software and learning tools, shaped through research, technical craft, and close attention to the people using them.</p>
          <a class="text-link" href="#work" data-hero-link>Selected work <span aria-hidden="true">→</span></a>
        </div>
        <div class="grid-visual" aria-hidden="true"><i class="grid-point"></i></div>
      </section>
    </div>

    <section class="section work" id="work" aria-labelledby="work-title">
      <div class="page">
        <div class="section-heading">
          <div class="eyebrow">Selected work</div>
          <h2 id="work-title">Tools that make learning and operations clearer.</h2>
        </div>
        {projects.map((project) => (
          <article class:list={["project", project.className]} id={project.name.toLowerCase()} data-project>
            <div class="project-meta">
              <div class="project-number">{project.number}</div>
              <p>{project.description}</p>
            </div>
            <div class="project-content">
              <h3 class="project-title"><a href={`/work/${project.slug}/`}>{project.name}</a></h3>
              <div class="project-facts"><span>{project.category}</span><span>{project.role}</span><span>{project.year}</span></div>
              <a class="project-media" href={`/work/${project.slug}/`} aria-label={`Read about ${project.name}`}>
                <img src={project.image} width="1600" height="1000" loading="lazy" decoding="async" alt="Editorial product image for the project" />
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="section index" aria-labelledby="index-title">
      <div class="page index-grid">
        <div>
          <div class="section-heading"><h2 id="index-title">Index of work</h2></div>
          <ol class="index-list">
            {projects.map((project) => <li><a href={`/work/${project.slug}/`}><span class="project-number">{project.number}</span><strong>{project.name}</strong><span class="meta">{project.category} · {project.year}</span></a></li>)}
          </ol>
        </div>
        <aside class="index-aside"><p>Three active directions, connected by a common interest in more thoughtful tools for learning and everyday work.</p></aside>
      </div>
    </section>

    <section class="section capabilities" aria-labelledby="capabilities-title">
      <div class="page">
        <div class="section-heading"><div class="eyebrow">Capabilities</div><h2 id="capabilities-title">From the product question to the working system.</h2></div>
        <div class="capability-grid">
          <div class="capability"><h3>Product design</h3><p>Frame problems, turn research into a usable flow, and make the interface explain itself.</p></div>
          <div class="capability"><h3>Frontend engineering</h3><p>Build responsive, accessible interfaces that preserve the intent of the product on every screen.</p></div>
          <div class="capability"><h3>Backend systems</h3><p>Design reliable data boundaries, local-first behavior, and practical synchronization for real work.</p></div>
          <div class="capability"><h3>AI and applied ML</h3><p>Shape AI into focused workflows that diagnose, teach, and give people useful next steps.</p></div>
        </div>
      </div>
    </section>

    <section class="section recognition" id="research" aria-labelledby="research-title">
      <div class="page">
        <div class="section-heading"><h2 id="research-title">Research in the product.</h2></div>
        <div class="timeline">
          <article class="timeline-item"><div class="timeline-year">Current</div><div><h3>Reasoning diagnosis for maths learning</h3><p>ReTrace prioritizes the first invalid step in a solution, then tests the likely misconception before teaching it.</p></div></article>
          <article class="timeline-item"><div class="timeline-year">Current</div><div><h3>Local-first educational operations</h3><p>TutPro keeps the teaching workspace usable without reliable connectivity while its data model evolves toward multi-school collaboration.</p></div></article>
          <article class="timeline-item"><div class="timeline-year">2026</div><div><h3>Accessible English speaking practice</h3><p>Talk in Action is an initiative to create an online space where teenagers in Ukraine can practise English and connect across regions.</p></div></article>
        </div>
      </div>
    </section>

    <section class="section about" id="about" aria-labelledby="about-title">
      <div class="page"><div class="about-inner">
        <div class="eyebrow">About</div>
        <h2 id="about-title">The interesting part is making the hard thing feel obvious.</h2>
        <p>I work at the boundary of product design and engineering, with a particular focus on education technology. I care about the system behind the screen as much as the screen itself.</p>
        <p>My projects begin with a concrete user problem and stay close to it through interface design, implementation, and iteration.</p>
        <div class="facts"><span>Product systems</span><span>EdTech</span><span>Research-led design</span><span>Ukraine</span></div>
      </div></div>
    </section>

    <section class="section contact" id="contact" aria-labelledby="contact-title">
      <div class="page">
        <div class="eyebrow">Contact</div>
        <h2 id="contact-title">Let's build something useful.</h2>
        <div class="contact-links"><a href="https://github.com/areteeem">GitHub</a></div>
      </div>
    </section>
  </main>
  <footer class="page footer"><span>© {new Date().getFullYear()} Artem</span><a href="#top">Back to top</a></footer>
  <script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";
    gsap.registerPlugin(ScrollTrigger);
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const header = document.querySelector("[data-header]");
    ScrollTrigger.create({ start: 16, onToggle: self => header?.classList.toggle("is-scrolled", self.isActive) });
    if (!reduced) {
      const title = document.querySelector("[data-hero-title]");
      const intro = document.querySelectorAll("[data-hero-meta], [data-hero-copy], [data-hero-link]");
      gsap.set(title, { y: 28, opacity: 0 });
      gsap.set(intro, { y: 12, opacity: 0 });
      gsap.timeline({ defaults: { ease: "power3.out" } }).to(title, { y: 0, opacity: 1, duration: .7 }).to(intro, { y: 0, opacity: 1, duration: .42, stagger: .08 }, "-=.38");
      gsap.utils.toArray<HTMLElement>("[data-project]").forEach(project => {
        const media = project.querySelector(".project-media");
        gsap.fromTo(media, { clipPath: "inset(0 0 100% 0)" }, { clipPath: "inset(0 0 0% 0)", duration: .75, ease: "power3.out", scrollTrigger: { trigger: project, start: "top 78%", once: true } });
      });
      const mediaQuery = gsap.matchMedia();
      mediaQuery.add("(hover: hover) and (pointer: fine)", () => {
        gsap.utils.toArray<HTMLElement>("[data-project]").forEach(project => {
          const image = project.querySelector("img");
          project.addEventListener("pointerenter", () => gsap.to(image, { scale: 1.025, duration: .45, ease: "power3.out", overwrite: "auto" }));
          project.addEventListener("pointerleave", () => gsap.to(image, { scale: 1, duration: .45, ease: "power3.out", overwrite: "auto" }));
        });
      });
    }
  </script>
</BaseLayout>
