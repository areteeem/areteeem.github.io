---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/global.css";
import { socials } from "../data/projects";
import { prompts } from "../data/prompts";

type GithubStar = { name: string; owner: string; url: string; website: string; category?: string; description: string | null; language: string | null; stars: number; topics: string[]; license: string | null; starredAt: string };

const githubFavorites = [
  ["Stirling-Tools/Stirling-PDF", "https://stirling.com"], ["public-apis/public-apis", "https://APILayer.com/?utm_source=Github&utm_medium=Referral&utm_campaign=Public-apis-repo"], ["usestrix/strix", "https://strix.ai"], ["kevinjycui/DesmosBezierRenderer", "https://www.youtube.com/watch?v=BQvBq3K50u8"], ["Leonxlnx/taste-skill", "https://tasteskill.dev"], ["zsh-eng/spaced2", "https://spaced2.zsheng.app"], ["danny-avila/LibreChat", "https://librechat.ai/"], ["calcom/cal.diy", "https://cal.diy"], ["makeplane/plane", "http://plane.so"], ["agalwood/Motrix", "https://motrix.app"], ["plausible/analytics", "https://plausible.io"], ["caamer20/Telegram-Drive", "https://www.cameronamer.com"], ["facebook/lexical", "https://lexical.dev"], ["nuxt-content/docus", "https://docus.dev"], ["facebook/docusaurus", "https://docusaurus.io"], ["PipedreamHQ/pipedream", "https://pipedream.com"], ["hyperion-cs/dpi-checkers", "https://hyperion-cs.github.io/dpi-checkers/"], ["mayneyao/eidos", "https://eidos.space"], ["abhigyanpatwari/GitNexus", "https://gitnexus.vercel.app"], ["formbricks/formbricks", "https://formbricks.com"], ["heyform/heyform", "https://heyform.net"], ["cms-dev/cms", "http://cms-dev.github.io/"], ["squidfunk/mkdocs-material", "https://squidfunk.github.io/mkdocs-material/"], ["GorvGoyl/Clone-Wars", "https://gourav.io/clone-wars"], ["chenglou/pretext", "http://chenglou.me/pretext/"], ["sipeed/picoclaw", "https://picoclaw.io"], ["AppFlowy-IO/AppFlowy", "https://appflowy.com"], ["zotero/zotero", "https://www.zotero.org"], ["vkaswin/google-jamboard", "https://vkaswin.github.io/google-jamboard"], ["KrishGaur1354/silkboard", "https://fossunited.org/hack/fosshack25/p/slq6ghdelm"], ["OpenBoard-org/OpenBoard", "https://openboard.ch/"], ["lovasoa/whitebophir", "https://wbo.ophir.dev"], ["timruffles/mobile-drag-drop", "http://timruffles.github.io/mobile-drag-drop/demo/"], ["TheDomcio/WonderfulPolishLanguage", "https://thedomcio.github.io/WonderfulPolishLanguage"], ["jgraph/drawio", "https://www.drawio.com"], ["openclaw/openclaw", "https://openclaw.ai"], ["logancyang/obsidian-copilot", "https://www.obsidiancopilot.com"], ["obsidianmd/obsidian-releases", "https://obsidian.md"], ["samuelmeuli/mini-diary", "https://minidiary.app"], ["slidevjs/slidev", "https://sli.dev"], ["FOSSEE/online_test", "https://yaksh.fossee.in"], ["umodoc/editor", "https://www.umodoc.com"], ["blackav/ejudge", "https://ejudge.ru"], ["lakesare/memcode", "http://memcode.com"], ["miroapp/app-examples", "https://developers.miro.com/"], ["inventree/InvenTree", "https://docs.inventree.org"], ["partkeepr/PartKeepr", "http://www.partkeepr.org"], ["SuiteCRM/SuiteCRM", "https://www.suitecrm.com"], ["ZeppelinBot/Zeppelin", "https://zeppelin.gg/"],
] as const;

const githubCategories: Record<string, string> = {
  "Stirling-Tools/Stirling-PDF": "Documents & PDFs", "public-apis/public-apis": "APIs & development", "usestrix/strix": "AI & security", "kevinjycui/DesmosBezierRenderer": "Maths & visualization", "Leonxlnx/taste-skill": "Design & AI", "zsh-eng/spaced2": "Learning & memory", "danny-avila/LibreChat": "AI & chat", "calcom/cal.diy": "Scheduling", "makeplane/plane": "Project management", "agalwood/Motrix": "Downloads", "plausible/analytics": "Analytics & privacy", "caamer20/Telegram-Drive": "Storage", "facebook/lexical": "Editors & UI", "nuxt-content/docus": "Documentation", "facebook/docusaurus": "Documentation", "PipedreamHQ/pipedream": "Automation & APIs", "hyperion-cs/dpi-checkers": "Privacy & network", "mayneyao/eidos": "Personal knowledge", "abhigyanpatwari/GitNexus": "Developer tools", "formbricks/formbricks": "Forms & feedback", "heyform/heyform": "Forms & feedback", "cms-dev/cms": "Education", "squidfunk/mkdocs-material": "Documentation", "GorvGoyl/Clone-Wars": "Learning & references", "chenglou/pretext": "Developer tools", "sipeed/picoclaw": "AI & automation", "AppFlowy-IO/AppFlowy": "Productivity", "zotero/zotero": "Research", "vkaswin/google-jamboard": "Whiteboards", "KrishGaur1354/silkboard": "Whiteboards", "OpenBoard-org/OpenBoard": "Whiteboards", "lovasoa/whitebophir": "Whiteboards", "timruffles/mobile-drag-drop": "Developer tools", "TheDomcio/WonderfulPolishLanguage": "Learning", "jgraph/drawio": "Diagrams", "openclaw/openclaw": "AI & automation", "logancyang/obsidian-copilot": "Personal knowledge", "obsidianmd/obsidian-releases": "Personal knowledge", "samuelmeuli/mini-diary": "Personal knowledge", "slidevjs/slidev": "Presentations", "FOSSEE/online_test": "Education", "umodoc/editor": "Editors & UI", "blackav/ejudge": "Education", "lakesare/memcode": "Learning & memory", "miroapp/app-examples": "Whiteboards", "inventree/InvenTree": "Inventory", "partkeepr/PartKeepr": "Inventory", "SuiteCRM/SuiteCRM": "CRM", "ZeppelinBot/Zeppelin": "Community tools",
};

const fallbackGithubStars: GithubStar[] = [
  { name: "Stirling-PDF", owner: "Stirling-Tools", url: "https://github.com/Stirling-Tools/Stirling-PDF", website: "https://stirling.com", description: "PDF application with editing and conversion tools.", language: "Java", stars: 89783, topics: ["pdf", "self-hosted", "ocr"], license: null, starredAt: "2026-08-07" },
  { name: "public-apis", owner: "public-apis", url: "https://github.com/public-apis/public-apis", website: "https://APILayer.com/?utm_source=Github&utm_medium=Referral&utm_campaign=Public-apis-repo", description: "A collective list of free APIs.", language: "Python", stars: 463975, topics: ["api", "development", "free"], license: "MIT", starredAt: "2026-08-06" },
  { name: "strix", owner: "usestrix", url: "https://github.com/usestrix/strix", website: "https://strix.ai", description: "Open-source AI penetration testing tool.", language: "Python", stars: 54907, topics: ["ai-security", "pentesting", "security"], license: "Apache-2.0", starredAt: "2026-08-03" },
  { name: "taste-skill", owner: "Leonxlnx", url: "https://github.com/Leonxlnx/taste-skill", website: "https://tasteskill.dev", description: "A skill for improving AI-generated frontend taste.", language: "JavaScript", stars: 77646, topics: ["design", "frontend", "skills"], license: "MIT", starredAt: "2026-07-27" },
  { name: "spaced2", owner: "zsh-eng", url: "https://github.com/zsh-eng/spaced2", website: "https://spaced2.zsheng.app", description: "Beautiful local-first flashcards.", language: "TypeScript", stars: 32, topics: ["flashcards", "local-first", "spaced-repetition"], license: null, starredAt: "2026-07-26" },
];
const githubStars = await fetch("https://api.github.com/users/areteeem/starred?per_page=100", { headers: { Accept: "application/vnd.github.v3.star+json", "User-Agent": "areteeem-portfolio" } })
  .then(async response => {
    if (!response.ok) throw new Error(`GitHub returned ${response.status}`);
    const stars = await response.json();
    const byFullName = new Map(stars.map(({ starred_at, repo }: any) => [repo.full_name.toLowerCase(), { starredAt: starred_at, repo }]));
    return githubFavorites.map(([fullName, website]): GithubStar => { const found = byFullName.get(fullName.toLowerCase()); const [owner, name] = fullName.split("/"); const repo = found?.repo; return { name: repo?.name ?? name, owner: repo?.owner.login ?? owner, url: repo?.html_url ?? `https://github.com/${fullName}`, website, category: githubCategories[fullName], description: repo?.description ?? null, language: repo?.language ?? null, stars: repo?.stargazers_count ?? 0, topics: repo?.topics ?? [], license: repo?.license?.spdx_id ?? null, starredAt: found?.starredAt?.slice(0, 10) ?? "" }; });
  })
  .catch(() => fallbackGithubStars);

type Resource = { name: string; url: string; note: string; tags: string[] };
type ResourceCategory = { category: string; items: Resource[] };

const resources: ResourceCategory[] = [
  { category: "Whiteboards & Diagrams", items: [
    { name: "Excalidraw", url: "https://excalidraw.com/", note: "A sketchy shared whiteboard for getting an interface or system idea out quickly.", tags: ["whiteboard", "diagram", "visualization"] },
    { name: "tldraw", url: "https://tldraw.com/", note: "An infinite canvas for drawing, diagramming, and building visual ideas together.", tags: ["whiteboard", "diagram", "visualization"] },
    { name: "diagrams.net / draw.io", url: "https://app.diagrams.net/", note: "For clean flowcharts, database diagrams, and the diagrams that need to be precise.", tags: ["diagram", "flowchart", "developer-tools"] },
    { name: "Jotboard", url: "https://www.jotboard.com/", note: "A shared online whiteboard for quick visual collaboration.", tags: ["whiteboard", "collaboration", "visualization"] },
    { name: "Mermaid Live Editor", url: "https://mermaid.ai/live/", note: "Write diagram definitions and preview flowcharts, sequence diagrams, and more in the browser.", tags: ["diagram", "developer-tools", "visualization"] },
    { name: "JSON Crack", url: "https://jsoncrack.com/", note: "Turns JSON and other structured data into interactive visual maps.", tags: ["json", "developer-tools", "visualization", "data"] },
  ] },
  { category: "Reading & Summarization", items: [
    { name: "TLDR This", url: "https://www.tldrthis.com/", note: "A text and article summarization tool. The free tier includes unlimited basic key-sentence summaries, but only 10 advanced AI summaries as a one-time allowance.", tags: ["reading", "summarization", "ai"] },
    { name: "Project Gutenberg", url: "https://www.gutenberg.org/", note: "A deep shelf of free eBooks, especially when I want to find an older work without friction.", tags: ["reading", "books", "learning"] },
    { name: "Digitalbook.io", url: "https://digitalbook.io/", note: "Free public-domain eBooks and audiobooks in one searchable catalogue.", tags: ["reading", "books", "audiobooks"] },
    { name: "A Good Movie to Watch", url: "https://www.agoodmovietowatch.com/", note: "Film recommendations with filters for English-language titles and free-to-watch options where available.", tags: ["movies", "english", "free"] },
    { name: "Notesnook", url: "https://notesnook.com/", note: "A privacy-minded, open-source note-taking option worth keeping in the toolkit.", tags: ["notes", "writing", "privacy"] },
  ] },
  { category: "Development Utilities", items: [
    { name: "DevDocs", url: "https://devdocs.io/", note: "Fast, searchable documentation for many developer APIs in one interface.", tags: ["developer-tools", "documentation", "api"] },
    { name: "regex101", url: "https://regex101.com/", note: "A regex tester with explanations, match highlighting, and language-specific flavours.", tags: ["developer-tools", "regex", "testing"] },
    { name: "Hoppscotch", url: "https://hoppscotch.com/", note: "A lightweight API-development client for testing HTTP, GraphQL, and WebSocket requests.", tags: ["developer-tools", "api", "web"] },
    { name: "roadmap.sh", url: "https://roadmap.sh/", note: "Community learning roadmaps and practical guides for developers.", tags: ["developer-tools", "learning", "career"] },
    { name: "shadcn/ui", url: "https://ui.shadcn.com/", note: "Open, composable UI components and patterns for building web interfaces.", tags: ["developer-tools", "ui", "web"] },
    { name: "Squoosh", url: "https://squoosh.app/", note: "A browser-based image compressor and format converter.", tags: ["developer-tools", "image", "performance"] },
    { name: "Supabase", url: "https://supabase.com/", note: "The backend platform behind several projects here: Postgres, auth, storage, and more in one place.", tags: ["developer-tools", "database", "backend"] },
    { name: "Vercel", url: "https://vercel.com/", note: "Where I look first when a web project needs a fast path from repository to deployment.", tags: ["developer-tools", "deployment", "web"] },
    { name: "Cal.com", url: "https://cal.com/", note: "Open scheduling infrastructure for booking workflows and calendar coordination.", tags: ["developer-tools", "scheduling", "web"] },
  ] },
  { category: "Image & Design Utilities", items: [
    { name: "Photopea", url: "https://www.photopea.com/", note: "A browser-based image editor with layered-file support.", tags: ["image", "design", "editor"] },
    { name: "Openverse", url: "https://openverse.org/", note: "A search engine for openly licensed and public-domain media. Check each asset's individual licence before use.", tags: ["image", "design", "licensing"] },
    { name: "SVG Repo", url: "https://www.svgrepo.com/", note: "A large, searchable collection of SVG icons and illustrations.", tags: ["image", "design", "icons"] },
    { name: "Iconify", url: "https://iconify.design/", note: "A unified icon library. Individual icon sets can have different licences, so check the set before use.", tags: ["image", "design", "icons", "licensing"] },
    { name: "Mobbin", url: "https://mobbin.com/", note: "A reference library of real product interfaces and user flows.", tags: ["design", "ui", "inspiration"] },
    { name: "Motion BGs", url: "https://motionbgs.com/", note: "A source of motion backgrounds for presentations and web work.", tags: ["design", "motion", "video"] },
  ] },
  { category: "Free Learning", items: [
    { name: "PhET", url: "https://phet.colorado.edu/", note: "Interactive science simulations I use when an abstract idea needs something to move.", tags: ["learning", "science", "simulation"] },
    { name: "GeoGebra", url: "https://www.geogebra.org/", note: "For graphing, geometry, and making maths feel less fixed on a page.", tags: ["learning", "maths", "visualization"] },
    { name: "MIT OpenCourseWare", url: "https://ocw.mit.edu/", note: "Free course material from MIT. It provides learning materials, not certificates.", tags: ["learning", "courses", "university"] },
    { name: "Learn Anything", url: "https://learn-anything.xyz/", note: "A community-built map of learning paths and useful resources.", tags: ["learning", "roadmaps", "community"] },
    { name: "Google Career Certificates", url: "https://www.skills.google/collections/career-certificates", note: "Google's collection of career-certificate learning programmes.", tags: ["learning", "career", "certificates"] },
    { name: "Instructables", url: "https://www.instructables.com/", note: "Step-by-step projects and practical how-to guides from a large maker community.", tags: ["learning", "makers", "projects"] },
    { name: "Animagraffs", url: "https://www.animagraffs.com/", note: "Detailed animated explainers for understanding how complex things work.", tags: ["learning", "science", "visualization"] },
    { name: "Human Benchmark", url: "https://humanbenchmark.com/", note: "Short tests for memory, reaction time, attention, and other cognitive skills.", tags: ["learning", "practice", "cognition"] },
  ] },
];

const resourceTags = [...new Set(resources.flatMap(({ items }) => items.flatMap(({ tags }) => tags)))].sort();
const featuredResourceTags = ["whiteboard", "diagram", "reading", "developer-tools", "image", "design", "learning", "free"];
const otherResourceTags = resourceTags.filter(tag => !featuredResourceTags.includes(tag));
---
<BaseLayout title="Resources - Artem Kachan" description="A personal collection of useful internet resources and AI prompts from Artem Kachan.">
  <a class="skip" href="#content">Skip to content</a>
  <header class="site-header site-header--static"><nav class="page nav" aria-label="Primary navigation"><a class="mark" href="/">Artem K.</a><div class="nav-links"><a class="nav-link" href="/work/">Work</a><a class="nav-link" href="/research/">Research</a><a class="nav-link" href="/resources/" aria-current="page">Resources</a><a class="nav-link" href="/about/">About</a><a class="nav-link" href={socials.cv}>CV ↗</a><a class="nav-link" href={socials.github}>GitHub ↗</a></div></nav></header>
  <main id="content" class="resources-page"><section class="page resources-hero"><div class="eyebrow">Personal collection</div><h1>Useful corners of the internet I keep coming back to.</h1><p>Tools, references, and working prompts that have proved useful in real work.</p></section><section class="section resources" id="resources"><div class="page"><div class="resource-filter" aria-label="Filter resources by tag"><button type="button" class="resource-filter-button is-active" data-resource-filter="all" aria-pressed="true">All</button>{featuredResourceTags.map(tag => <button type="button" class="resource-filter-button" data-resource-filter={tag} aria-pressed="false">{tag}</button>)}<details class="resource-filter-more"><summary>More tags</summary><div>{otherResourceTags.map(tag => <button type="button" class="resource-filter-button" data-resource-filter={tag} aria-pressed="false">{tag}</button>)}</div></details></div><div class="resource-groups">{resources.map(({ category, items }) => <section class="resource-group" data-resource-category><h2>{category}</h2><div class="resource-grid">{items.map(({ name, url, note, tags }) => <a class="resource-row" href={url} target="_blank" rel="noreferrer" data-resource-card data-resource-tags={tags.join(" ")}><span class="resource-name"><strong>{name}</strong><small>{new URL(url).hostname.replace("www.", "")}</small></span><span class="resource-note">{note}</span><span class="resource-tags" aria-label={`Tags: ${tags.join(", ")}`}>{tags.map(tag => <span>#{tag}</span>)}</span><span class="resource-arrow" aria-hidden="true">↗</span></a>)}</div></section>)}</div><p class="resource-empty" data-resource-empty hidden>No resources match this tag yet.</p></div></section><section class="section github-stars" id="github-stars"><div class="page"><div class="section-heading"><div class="eyebrow">From my GitHub stars</div><h2>Projects I want to keep an eye on.</h2><p>Selected favorites, with their official sites where I have saved one.</p><a class="text-link" href="https://github.com/areteeem?tab=stars" target="_blank" rel="noreferrer">See more on my starred page on GitHub <span aria-hidden="true">↗</span></a></div><div class="github-star-grid">{githubStars.map((repo) => <article class="github-star"><a class="github-star-meta" href={repo.url} target="_blank" rel="noreferrer">{repo.owner} / {repo.name} <span aria-hidden="true">↗</span></a><span class="github-star-category">{repo.category || "Open source"}</span><p>{repo.description || "Saved from my public GitHub stars."}</p><span class="github-star-details"><span>{repo.language || "Code"}</span>{repo.stars > 0 && <span>★ {repo.stars.toLocaleString()}</span>}{repo.license && <span>{repo.license}</span>}</span><a class="github-star-site" href={repo.website} target="_blank" rel="noreferrer">Visit project site <span aria-hidden="true">↗</span></a></article>)}</div></div></section><section class="section prompts" id="prompts"><div class="page"><div class="section-heading prompts-heading"><div class="eyebrow">AI prompts</div><h2>Prompts I keep coming back to.</h2><p>Personal working notes for research, opportunity-finding, email organization, and product critique.</p></div><div class="prompt-grid">{prompts.map((prompt) => <article class="prompt-card"><button type="button" class="prompt-open" data-prompt-open={prompt.slug}><span class="prompt-card-top"><span class="prompt-category">{prompt.category}</span><span class="prompt-open-label">Open prompt <span aria-hidden="true">↗</span></span></span><h3>{prompt.title}</h3><p>{prompt.description}</p><span class="prompt-tags">{prompt.tags.map(tag => <span>{tag}</span>)}</span><span class="prompt-updated">Updated <time datetime={prompt.updatedAt}>{prompt.updatedAt}</time></span></button></article>)}</div></div></section></main>
  <footer class="page footer"><span>Artem Kachan · Kyiv, Ukraine</span><div><a href="/">Home</a> · <a href="/work/">Work</a> · <a href="/research/">Research</a> · <a href="/about/">About</a></div><span>2026 · Astro</span></footer>
  <dialog class="prompt-dialog" data-prompt-dialog aria-labelledby="prompt-dialog-title"><div class="prompt-dialog-shell"><header class="prompt-dialog-header"><div><span class="prompt-category" data-prompt-category></span><h2 id="prompt-dialog-title" data-prompt-title></h2></div><form method="dialog"><button type="submit" class="prompt-close">Close <span aria-hidden="true">×</span></button></form></header><p class="prompt-dialog-description" data-prompt-description></p><div class="prompt-dialog-actions"><button type="button" data-copy-prompt>Copy prompt</button><button type="button" data-copy-markdown>Copy as Markdown</button><span data-copy-status aria-live="polite"></span></div><div class="prompt-dialog-body"><pre data-prompt-body></pre></div><footer class="prompt-dialog-footer"><span data-prompt-tags></span><p><strong>Recommended use:</strong> <span data-prompt-usage></span></p></footer></div></dialog>
  <script is:inline define:vars={{ prompts }}>
    const resourceFilterButtons = document.querySelectorAll("[data-resource-filter]");
    const resourceCards = document.querySelectorAll("[data-resource-card]");
    const resourceCategories = document.querySelectorAll("[data-resource-category]");
    const resourceEmpty = document.querySelector("[data-resource-empty]");
    resourceFilterButtons.forEach(button => button.addEventListener("click", () => {
      const selected = button.dataset.resourceFilter;
      let visibleCards = 0;
      resourceFilterButtons.forEach(item => { const active = item === button; item.classList.toggle("is-active", active); item.setAttribute("aria-pressed", String(active)); });
      resourceCards.forEach(card => { const visible = selected === "all" || card.dataset.resourceTags?.split(" ").includes(selected); card.hidden = !visible; if (visible) visibleCards += 1; });
      resourceCategories.forEach(category => { category.hidden = !category.querySelector("[data-resource-card]:not([hidden])"); });
      if (resourceEmpty) resourceEmpty.hidden = visibleCards > 0;
    }));
    const dialog = document.querySelector("[data-prompt-dialog]");
    const promptMap = new Map(prompts.map(prompt => [prompt.slug, prompt]));
    const promptCache = new Map(); let activePrompt;
    const promptTitle = dialog?.querySelector("[data-prompt-title]"); const promptCategory = dialog?.querySelector("[data-prompt-category]"); const promptDescription = dialog?.querySelector("[data-prompt-description]"); const promptBody = dialog?.querySelector("[data-prompt-body]"); const promptTags = dialog?.querySelector("[data-prompt-tags]"); const promptUsage = dialog?.querySelector("[data-prompt-usage]"); const copyStatus = dialog?.querySelector("[data-copy-status]");
    const openPrompt = async (slug, updateUrl = true) => { const prompt = promptMap.get(slug); if (!dialog || !prompt) return; activePrompt = prompt; promptTitle.textContent = prompt.title; promptCategory.textContent = prompt.category; promptDescription.textContent = prompt.description; promptUsage.textContent = prompt.usageNote; promptTags.textContent = prompt.tags.map(tag => `#${tag}`).join("  "); promptBody.textContent = "Loading prompt..."; copyStatus.textContent = ""; if (!dialog.open) dialog.showModal(); if (updateUrl) { const url = new URL(window.location.href); url.searchParams.set("prompt", slug); history.pushState({}, "", url); } try { const text = promptCache.get(slug) || await fetch(prompt.promptUrl).then(response => { if (!response.ok) throw new Error("Prompt unavailable"); return response.text(); }); promptCache.set(slug, text); if (activePrompt?.slug === slug) promptBody.textContent = text; } catch { if (activePrompt?.slug === slug) promptBody.textContent = "This prompt could not be loaded. Please try again."; } };
    document.querySelectorAll("[data-prompt-open]").forEach(button => button.addEventListener("click", () => openPrompt(button.dataset.promptOpen)));
    dialog?.addEventListener("close", () => { const url = new URL(window.location.href); if (url.searchParams.has("prompt")) { url.searchParams.delete("prompt"); history.replaceState({}, "", url); } });
    const copy = async (markdown = false) => { if (!activePrompt || !promptBody?.textContent || promptBody.textContent === "Loading prompt...") return; const value = markdown ? `# ${activePrompt.title}\n\n${activePrompt.description}\n\n${promptBody.textContent}` : promptBody.textContent; try { await navigator.clipboard.writeText(value); copyStatus.textContent = "Copied"; } catch { copyStatus.textContent = "Copy unavailable"; } };
    dialog?.querySelector("[data-copy-prompt]")?.addEventListener("click", () => copy()); dialog?.querySelector("[data-copy-markdown]")?.addEventListener("click", () => copy(true));
    const requestedPrompt = new URLSearchParams(window.location.search).get("prompt"); if (requestedPrompt) openPrompt(requestedPrompt, false);
  </script>
</BaseLayout>
