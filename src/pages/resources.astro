---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/global.css";
import { socials } from "../data/projects";
import { prompts } from "../data/prompts";

type GithubStar = { name: string; owner: string; url: string; website: string; description: string | null; language: string | null; stars: number; topics: string[]; license: string | null; starredAt: string };

const githubFavorites = [
  ["Stirling-Tools/Stirling-PDF", "https://stirling.com"], ["public-apis/public-apis", "https://APILayer.com/?utm_source=Github&utm_medium=Referral&utm_campaign=Public-apis-repo"], ["usestrix/strix", "https://strix.ai"], ["kevinjycui/DesmosBezierRenderer", "https://www.youtube.com/watch?v=BQvBq3K50u8"], ["Leonxlnx/taste-skill", "https://tasteskill.dev"], ["zsh-eng/spaced2", "https://spaced2.zsheng.app"], ["danny-avila/LibreChat", "https://librechat.ai/"], ["calcom/cal.diy", "https://cal.diy"], ["makeplane/plane", "http://plane.so"], ["agalwood/Motrix", "https://motrix.app"], ["plausible/analytics", "https://plausible.io"], ["caamer20/Telegram-Drive", "https://www.cameronamer.com"], ["facebook/lexical", "https://lexical.dev"], ["nuxt-content/docus", "https://docus.dev"], ["facebook/docusaurus", "https://docusaurus.io"], ["PipedreamHQ/pipedream", "https://pipedream.com"], ["hyperion-cs/dpi-checkers", "https://hyperion-cs.github.io/dpi-checkers/"], ["mayneyao/eidos", "https://eidos.space"], ["abhigyanpatwari/GitNexus", "https://gitnexus.vercel.app"], ["formbricks/formbricks", "https://formbricks.com"], ["heyform/heyform", "https://heyform.net"], ["cms-dev/cms", "http://cms-dev.github.io/"], ["squidfunk/mkdocs-material", "https://squidfunk.github.io/mkdocs-material/"], ["GorvGoyl/Clone-Wars", "https://gourav.io/clone-wars"], ["chenglou/pretext", "http://chenglou.me/pretext/"], ["sipeed/picoclaw", "https://picoclaw.io"], ["AppFlowy-IO/AppFlowy", "https://appflowy.com"], ["zotero/zotero", "https://www.zotero.org"], ["vkaswin/google-jamboard", "https://vkaswin.github.io/google-jamboard"], ["KrishGaur1354/silkboard", "https://fossunited.org/hack/fosshack25/p/slq6ghdelm"], ["OpenBoard-org/OpenBoard", "https://openboard.ch/"], ["lovasoa/whitebophir", "https://wbo.ophir.dev"], ["timruffles/mobile-drag-drop", "http://timruffles.github.io/mobile-drag-drop/demo/"], ["TheDomcio/WonderfulPolishLanguage", "https://thedomcio.github.io/WonderfulPolishLanguage"], ["jgraph/drawio", "https://www.drawio.com"], ["openclaw/openclaw", "https://openclaw.ai"], ["logancyang/obsidian-copilot", "https://www.obsidiancopilot.com"], ["obsidianmd/obsidian-releases", "https://obsidian.md"], ["samuelmeuli/mini-diary", "https://minidiary.app"], ["slidevjs/slidev", "https://sli.dev"], ["FOSSEE/online_test", "https://yaksh.fossee.in"], ["umodoc/editor", "https://www.umodoc.com"], ["blackav/ejudge", "https://ejudge.ru"], ["lakesare/memcode", "http://memcode.com"], ["miroapp/app-examples", "https://developers.miro.com/"], ["inventree/InvenTree", "https://docs.inventree.org"], ["partkeepr/PartKeepr", "http://www.partkeepr.org"], ["SuiteCRM/SuiteCRM", "https://www.suitecrm.com"], ["ZeppelinBot/Zeppelin", "https://zeppelin.gg/"],
] as const;

const fallbackGithubStars: GithubStar[] = [
  { name: "Stirling-PDF", owner: "Stirling-Tools", url: "https://github.com/Stirling-Tools/Stirling-PDF", website: "https://stirling.com", description: "PDF application with editing and conversion tools.", language: "Java", stars: 89783, topics: ["pdf", "self-hosted", "ocr"], license: null, starredAt: "2026-08-07" },
  { name: "public-apis", owner: "public-apis", url: "https://github.com/public-apis/public-apis", website: "https://APILayer.com/?utm_source=Github&utm_medium=Referral&utm_campaign=Public-apis-repo", description: "A collective list of free APIs.", language: "Python", stars: 463975, topics: ["api", "development", "free"], license: "MIT", starredAt: "2026-08-06" },
  { name: "strix", owner: "usestrix", url: "https://github.com/usestrix/strix", website: "https://strix.ai", description: "Open-source AI penetration testing tool.", language: "Python", stars: 54907, topics: ["ai-security", "pentesting", "security"], license: "Apache-2.0", starredAt: "2026-08-03" },
  { name: "taste-skill", owner: "Leonxlnx", url: "https://github.com/Leonxlnx/taste-skill", website: "https://tasteskill.dev", description: "A skill for improving AI-generated frontend taste.", language: "JavaScript", stars: 77646, topics: ["design", "frontend", "skills"], license: "MIT", starredAt: "2026-07-27" },
  { name: "spaced2", owner: "zsh-eng", url: "https://github.com/zsh-eng/spaced2", website: "https://spaced2.zsheng.app", description: "Beautiful local-first flashcards.", language: "TypeScript", stars: 32, topics: ["flashcards", "local-first", "spaced-repetition"], license: null, starredAt: "2026-07-26" },
];
const githubStars = await fetch("https://api.github.com/users/areteeem/starred?per_page=100", { headers: { Accept: "application/vnd.github.v3.star+json", "User-Agent": "areteeem-portfolio" } })
  .then(async response => {
    if (!response.ok) throw new Error(`GitHub returned ${response.status}`);
    const stars = await response.json();
    const byFullName = new Map(stars.map(({ starred_at, repo }: any) => [repo.full_name.toLowerCase(), { starredAt: starred_at, repo }]));
    return githubFavorites.map(([fullName, website]): GithubStar => { const found = byFullName.get(fullName.toLowerCase()); const [owner, name] = fullName.split("/"); const repo = found?.repo; return { name: repo?.name ?? name, owner: repo?.owner.login ?? owner, url: repo?.html_url ?? `https://github.com/${fullName}`, website, description: repo?.description ?? null, language: repo?.language ?? null, stars: repo?.stargazers_count ?? 0, topics: repo?.topics ?? [], license: repo?.license?.spdx_id ?? null, starredAt: found?.starredAt?.slice(0, 10) ?? "" }; });
  })
  .catch(() => fallbackGithubStars);

const resources = [
  { category: "Learning", items: [["PhET", "phet.colorado.edu", "Interactive science simulations I use when an abstract idea needs something to move."], ["GeoGebra", "geogebra.org", "For graphing, geometry, and making maths feel less fixed on a page."]] },
  { category: "Design & UI", items: [["Excalidraw", "excalidraw.com", "A sketchy shared whiteboard for getting an interface or system idea out quickly."], ["draw.io", "app.diagrams.net", "Useful for clean flowcharts, database diagrams, and the diagrams that need to be precise."]] },
  { category: "Reading", items: [["Project Gutenberg", "gutenberg.org", "A deep shelf of free eBooks, especially when I want to find an older work without friction."], ["Notesnook", "notesnook.com", "A privacy-minded, open-source note-taking option worth keeping in the toolkit."]] },
  { category: "Development", items: [["Supabase", "supabase.com", "The backend platform behind several projects here: Postgres, auth, storage, and more in one place."], ["Vercel", "vercel.com", "Where I look first when a web project needs a fast path from repository to deployment."]] },
] as const;
---
<BaseLayout title="Resources - Artem Kachan" description="A personal collection of useful internet resources and AI prompts from Artem Kachan.">
  <a class="skip" href="#content">Skip to content</a>
  <header class="site-header site-header--static"><nav class="page nav" aria-label="Primary navigation"><a class="mark" href="/">Artem K.</a><div class="nav-links"><a class="nav-link" href="/work/">Work</a><a class="nav-link" href="/research/">Research</a><a class="nav-link" href="/resources/" aria-current="page">Resources</a><a class="nav-link" href="/about/">About</a><a class="nav-link" href={socials.cv}>CV ↗</a><a class="nav-link" href={socials.github}>GitHub ↗</a></div></nav></header>
  <main id="content" class="resources-page"><section class="page resources-hero"><div class="eyebrow">Personal collection</div><h1>Useful corners of the internet I keep coming back to.</h1><p>Tools, references, and working prompts that have proved useful in real work.</p></section><section class="section resources" id="resources"><div class="page"><div class="resource-groups">{resources.map(({ category, items }) => <section class="resource-group"><h2>{category}</h2><div class="resource-grid">{items.map(([name, domain, note]) => <a class="resource-row" href={`https://${domain}`} target="_blank" rel="noreferrer"><span class="resource-name"><strong>{name}</strong><small>{domain}</small></span><span class="resource-note">{note}</span><span class="resource-arrow" aria-hidden="true">↗</span></a>)}</div></section>)}</div></div></section><section class="section github-stars" id="github-stars"><div class="page"><div class="section-heading"><div class="eyebrow">From my GitHub stars</div><h2>Projects I want to keep an eye on.</h2><p>Selected favorites, with their official sites where I have saved one.</p><a class="text-link" href="https://github.com/areteeem?tab=stars" target="_blank" rel="noreferrer">See more on my starred page on GitHub <span aria-hidden="true">↗</span></a></div><div class="github-star-grid">{githubStars.map((repo) => <article class="github-star"><a class="github-star-meta" href={repo.url} target="_blank" rel="noreferrer">{repo.owner} / {repo.name} <span aria-hidden="true">↗</span></a><p>{repo.description || "Saved from my public GitHub stars."}</p><span class="github-star-details"><span>{repo.language || "Code"}</span>{repo.stars > 0 && <span>★ {repo.stars.toLocaleString()}</span>}{repo.license && <span>{repo.license}</span>}</span><a class="github-star-site" href={repo.website} target="_blank" rel="noreferrer">Visit project site <span aria-hidden="true">↗</span></a></article>)}</div></div></section><section class="section prompts" id="prompts"><div class="page"><div class="section-heading prompts-heading"><div class="eyebrow">AI prompts</div><h2>Prompts I keep coming back to.</h2><p>Personal working notes for research, opportunity-finding, email organization, and product critique.</p></div><div class="prompt-grid">{prompts.map((prompt) => <article class="prompt-card"><button type="button" class="prompt-open" data-prompt-open={prompt.slug}><span class="prompt-card-top"><span class="prompt-category">{prompt.category}</span><span class="prompt-open-label">Open prompt <span aria-hidden="true">↗</span></span></span><h3>{prompt.title}</h3><p>{prompt.description}</p><span class="prompt-tags">{prompt.tags.map(tag => <span>{tag}</span>)}</span><span class="prompt-updated">Updated <time datetime={prompt.updatedAt}>{prompt.updatedAt}</time></span></button></article>)}</div></div></section></main>
  <footer class="page footer"><span>Artem Kachan · Kyiv, Ukraine</span><div><a href="/">Home</a> · <a href="/work/">Work</a> · <a href="/research/">Research</a> · <a href="/about/">About</a></div><span>2026 · Astro</span></footer>
  <dialog class="prompt-dialog" data-prompt-dialog aria-labelledby="prompt-dialog-title"><div class="prompt-dialog-shell"><header class="prompt-dialog-header"><div><span class="prompt-category" data-prompt-category></span><h2 id="prompt-dialog-title" data-prompt-title></h2></div><form method="dialog"><button type="submit" class="prompt-close">Close <span aria-hidden="true">×</span></button></form></header><p class="prompt-dialog-description" data-prompt-description></p><div class="prompt-dialog-actions"><button type="button" data-copy-prompt>Copy prompt</button><button type="button" data-copy-markdown>Copy as Markdown</button><span data-copy-status aria-live="polite"></span></div><div class="prompt-dialog-body"><pre data-prompt-body></pre></div><footer class="prompt-dialog-footer"><span data-prompt-tags></span><p><strong>Recommended use:</strong> <span data-prompt-usage></span></p></footer></div></dialog>
  <script is:inline define:vars={{ prompts }}>
    const dialog = document.querySelector("[data-prompt-dialog]");
    const promptMap = new Map(prompts.map(prompt => [prompt.slug, prompt]));
    const promptCache = new Map(); let activePrompt;
    const promptTitle = dialog?.querySelector("[data-prompt-title]"); const promptCategory = dialog?.querySelector("[data-prompt-category]"); const promptDescription = dialog?.querySelector("[data-prompt-description]"); const promptBody = dialog?.querySelector("[data-prompt-body]"); const promptTags = dialog?.querySelector("[data-prompt-tags]"); const promptUsage = dialog?.querySelector("[data-prompt-usage]"); const copyStatus = dialog?.querySelector("[data-copy-status]");
    const openPrompt = async (slug, updateUrl = true) => { const prompt = promptMap.get(slug); if (!dialog || !prompt) return; activePrompt = prompt; promptTitle.textContent = prompt.title; promptCategory.textContent = prompt.category; promptDescription.textContent = prompt.description; promptUsage.textContent = prompt.usageNote; promptTags.textContent = prompt.tags.map(tag => `#${tag}`).join("  "); promptBody.textContent = "Loading prompt..."; copyStatus.textContent = ""; if (!dialog.open) dialog.showModal(); if (updateUrl) { const url = new URL(window.location.href); url.searchParams.set("prompt", slug); history.pushState({}, "", url); } try { const text = promptCache.get(slug) || await fetch(prompt.promptUrl).then(response => { if (!response.ok) throw new Error("Prompt unavailable"); return response.text(); }); promptCache.set(slug, text); if (activePrompt?.slug === slug) promptBody.textContent = text; } catch { if (activePrompt?.slug === slug) promptBody.textContent = "This prompt could not be loaded. Please try again."; } };
    document.querySelectorAll("[data-prompt-open]").forEach(button => button.addEventListener("click", () => openPrompt(button.dataset.promptOpen)));
    dialog?.addEventListener("close", () => { const url = new URL(window.location.href); if (url.searchParams.has("prompt")) { url.searchParams.delete("prompt"); history.replaceState({}, "", url); } });
    const copy = async (markdown = false) => { if (!activePrompt || !promptBody?.textContent || promptBody.textContent === "Loading prompt...") return; const value = markdown ? `# ${activePrompt.title}\n\n${activePrompt.description}\n\n${promptBody.textContent}` : promptBody.textContent; try { await navigator.clipboard.writeText(value); copyStatus.textContent = "Copied"; } catch { copyStatus.textContent = "Copy unavailable"; } };
    dialog?.querySelector("[data-copy-prompt]")?.addEventListener("click", () => copy()); dialog?.querySelector("[data-copy-markdown]")?.addEventListener("click", () => copy(true));
    const requestedPrompt = new URLSearchParams(window.location.search).get("prompt"); if (requestedPrompt) openPrompt(requestedPrompt, false);
  </script>
</BaseLayout>
