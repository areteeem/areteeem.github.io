---
import BaseLayout from "../../layouts/BaseLayout.astro"; import "../../styles/global.css"; import { projects } from "../../data/projects";
---
<BaseLayout title="Work | Artem Kachan" description="Selected work by Artem Kachan."><main class="page section"><a class="text-link" href="/">← Home</a><div class="section-heading" style="margin-top:4rem"><div class="eyebrow">Work</div><h1 class="case-title">Products, experiments, and systems.</h1></div><ol class="index-list">{projects.map(project => <li><a href={`/work/${project.slug}/`}><span class="project-number">{project.number}</span><strong>{project.name}</strong><span class="meta">{project.label}</span></a></li>)}</ol></main></BaseLayout>
