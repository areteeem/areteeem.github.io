---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/global.css";
import { projects, socials } from "../data/projects";
const featured = projects.filter((project) => project.featured);
const metrics = [["7,500+", "students"], ["26,000+", "lesson-hours"], ["490,000+", "study cards"], ["6,350+", "assessments"]];
---
<BaseLayout title="Artem Kachan - Product, Engineering & Research" description="Portfolio of Artem Kachan, a software developer and educational technologist building products across EdTech, AI, systems engineering, and research.">
  <a class="skip" href="#content">Skip to content</a>
  <div class="presentation-launch" aria-label="Open presentation mode"><button type="button" data-enter-prev aria-label="Open presentation at the final slide">←</button><button type="button" data-enter-next aria-label="Open presentation">→</button></div>
  <div class="presentation" data-presentation aria-label="Portfolio presentation" aria-roledescription="carousel">
    <section class="presentation-slide slide-intro" data-slide aria-label="Introduction">
      <div class="slide-grid"><div><div class="eyebrow">Artem Kachan</div><h1>I design and build systems for how people learn, reason, and work.</h1><p>Software developer and educational technologist from Kyiv, working across product engineering, EdTech, research, and applied AI.</p><a class="text-link" href="/work/">Explore full work <span aria-hidden="true">→</span></a></div><dl class="slide-metrics"><div><dt>7,500+</dt><dd>students</dd></div><div><dt>26,000+</dt><dd>academic hours</dd></div><div><dt>490,000+</dt><dd>flashcards</dd></div><div><dt>6,350+</dt><dd>assessments</dd></div></dl></div>
    </section>
    <section class="presentation-slide slide-project" data-slide aria-label="TutPro"><div class="slide-grid slide-project-grid"><div><div class="eyebrow">01 / Flagship project</div><h2>TutPro</h2><p>A multi-user education platform for tutors and schools, combining lessons, scheduling, homework, grading, payments, student management, and educational workflows.</p><p class="slide-meta">Founder · Product Lead · Developer</p><a class="text-link" href="/work/tutpro/">View case study <span aria-hidden="true">→</span></a></div><img src="/images/tutpro.webp" width="1280" height="960" alt="TutPro dashboard on a laptop" /></div></section>
    <section class="presentation-slide slide-project" data-slide aria-label="ReTrace"><div class="slide-grid slide-project-grid"><div><div class="eyebrow">02 / Experimental AI</div><h2>ReTrace</h2><p>An AI reasoning debugger that finds the first wrong turn in a student's solution and turns it into targeted learning material.</p><p class="slide-meta">Product design · AI workflows · Next.js</p><a class="text-link" href="/work/retrace/">View case study <span aria-hidden="true">→</span></a></div><img src="/images/retrace.webp" width="1600" height="1200" alt="ReTrace on a laptop" /></div></section>
    <section class="presentation-slide" data-slide aria-label="Engineering systems"><div class="slide-grid"><div><div class="eyebrow">03 / Systems engineering</div><h2>Evaly turns assessment integrity into product infrastructure.</h2><p>Academic examination platform rebuilt from HeyForm for structured testing, proctoring, course isolation, and evaluation.</p><a class="text-link" href="/work/evaly/">View case study <span aria-hidden="true">→</span></a></div><dl class="slide-list"><div><dt>6,350+</dt><dd>assessments conducted</dd></div><div><dt>Security</dt><dd>tab-focus monitoring, clipboard restrictions, full-screen enforcement, and randomized questions</dd></div><div><dt>System</dt><dd>TypeScript, JavaScript, Supabase, educational UX</dd></div></dl></div></section>
    <section class="presentation-slide slide-project" data-slide aria-label="GalaxyBar"><div class="slide-grid slide-project-grid"><div><div class="eyebrow">04 / Native software</div><h2>GalaxyBar</h2><p>A lightweight macOS menu bar utility for controlling Samsung Galaxy Buds, checking battery state, and switching ANC modes.</p><p class="slide-meta">Swift · AppKit · CoreBluetooth</p><a class="text-link" href="/work/galaxybar/">View case study <span aria-hidden="true">→</span></a></div><img src="/images/galaxybar.webp" width="1440" height="1322" alt="GalaxyBar setup interface" /></div></section>
    <section class="presentation-slide" data-slide aria-label="Research and recognition"><div class="slide-grid"><div><div class="eyebrow">05 / Research and recognition</div><h2>Build with evidence. Compete with intent.</h2><p>Research, competitive programming, and product work share one practice: make difficult systems legible and useful.</p><a class="text-link" href="/research/">View research <span aria-hidden="true">→</span></a></div><dl class="slide-list"><div><dt>2026</dt><dd>AdventureX selected participant from 6,000+ applicants</dd></div><div><dt>2025-26</dt><dd>Ukrainian Junior Informatics Olympiad, stages 1-3 winner</dd></div><div><dt>Research</dt><dd>Three Junior Academy of Sciences projects publicly defended</dd></div></dl></div></section>
    <section class="presentation-slide slide-about" data-slide aria-label="About Artem"><div class="slide-grid slide-project-grid"><div><div class="eyebrow">06 / About</div><h2>Education is a product problem I know from the inside.</h2><p>Developer, researcher, tutor, and community builder. I work from the real behavior of people who learn and teach.</p><a class="text-link" href="/about/">More about me <span aria-hidden="true">→</span></a></div><img src="/images/artem-kachan.webp" width="1600" height="919" alt="Artem Kachan holding a tablet" /></div></section>
    <section class="presentation-slide" data-slide aria-label="Contact"><div class="slide-grid"><div><div class="eyebrow">07 / Contact</div><h2>Let's build something useful.</h2><p>Product, engineering, research, education, or something difficult enough to be interesting.</p><div class="contact-links"><a href={socials.email}>Email ↗</a><a href={socials.telegram}>Telegram ↗</a><a href={socials.instagram}>Instagram ↗</a><a href={socials.github}>GitHub ↗</a><a href={socials.cv}>CV ↗</a></div></div><div class="slide-signoff">Artem K.<br/><span>Kyiv, Ukraine</span></div></div></section>
    <div class="presentation-controls" aria-label="Presentation controls"><button type="button" data-prev aria-label="Previous slide">←</button><span data-counter aria-live="polite">1 / 7</span><button type="button" data-exit>Exit presentation</button><button type="button" data-next aria-label="Next slide">→</button></div>
  </div>
  <header class="site-header" data-header><nav class="page nav" aria-label="Primary navigation"><a class="mark" href="#top">Artem K.</a><div class="nav-links"><a class="nav-link" href="#work">Work</a><a class="nav-link" href="#research">Research</a><a class="nav-link" href="/about/">About</a><a class="nav-link" href={socials.cv}>CV ↗</a><a class="nav-link" href={socials.github}>GitHub ↗</a></div></nav></header>
  <main id="content"><div class="page" id="top"><section class="hero" aria-labelledby="hero-title"><div class="hero-copy"><div class="eyebrow" data-hero-meta>Product · Engineering · Research</div><h1 id="hero-title" data-hero-title>I design and build systems for how people learn, reason, and work.</h1><p data-hero-copy>I'm Artem Kachan, a software developer and educational technologist from Kyiv working across product engineering, EdTech, research, and applied AI.</p><a class="text-link" href="#work" data-hero-link>Explore selected work <span aria-hidden="true">↓</span></a></div><div class="grid-visual" aria-hidden="true"><i class="grid-point"></i></div></section><section class="evidence" aria-label="Selected impact">{metrics.map(([number, label]) => <div><strong>{number}</strong><span>{label}</span></div>)}</section></div>
    <section class="section work" id="work"><div class="page"><div class="section-heading"><div class="eyebrow">Selected work</div><h2>Products with real operating context.</h2></div>{featured.map((project) => <article class:list={["project", project.slug === "tutpro" && "project--flagship"]} data-project><div class="project-meta"><div class="project-number">{project.number}</div><p>{project.label}</p></div><div class="project-content"><h3 class="project-title"><a href={`/work/${project.slug}/`}>{project.name}</a></h3><p class="project-description">{project.description}</p><div class="project-facts">{project.areas.map(area => <span>{area}</span>)}</div>{project.image && <a class="project-media" href={`/work/${project.slug}/`} aria-label={`Read about ${project.name}`}><img src={project.image} width="1600" height="1200" loading="lazy" decoding="async" alt={`${project.name} interface`} /></a>}{project.metrics && <div class="project-metrics">{project.metrics.map(metric => <span>{metric}</span>)}</div>}</div></article>)}</div></section>
    <section class="section impact"><div class="page"><div class="section-heading"><div class="eyebrow">Impact / selected numbers</div><h2>Deployed systems, not portfolio exercises.</h2></div><div class="impact-grid">{[["7,500+", "students reached through TutPro"], ["26,000+", "academic lesson-hours supported"], ["490,000+", "flashcards used through the ecosystem"], ["6,350+", "assessments conducted through Evaly"], ["15,000+", "members in an earlier online community"]].map(([number, label]) => <div data-reveal><strong>{number}</strong><span>{label}</span></div>)}</div></div></section>
    <section class="section index"><div class="page index-grid"><div><div class="section-heading"><h2>Work index</h2></div><ol class="index-list">{projects.map(project => <li><a href={`/work/${project.slug}/`} data-index-row><span class="project-number">{project.number}</span><strong>{project.name}</strong><span class="meta">{project.label}</span></a></li>)}</ol></div><aside class="index-aside"><p>Seven projects across education, native software, mathematical computation, finance, and interactive learning.</p></aside></div></section>
    <section class="section recognition" id="research"><div class="page"><div class="section-heading"><div class="eyebrow">Selected recognition</div><h2>Research, competition, and public work.</h2></div><div class="timeline" data-timeline>{[["2026", "AdventureX 2026 Hackathon", "Selected participant and app developer. Selected from 6,000+ international applicants."], ["2026", "3DevIT International Competition", "2nd place."], ["2025-2026", "Ukrainian Junior Informatics Olympiad", "Winner of stages 1-3."], ["2025", "Junior Academy of Sciences Informatics Olympiad", "Regional prize-winning participant."], ["2024", "National Mathematics Olympiad, Team Competition", "Prize-winning participant."]].map(([year, title, detail]) => <article class="timeline-item" data-timeline-item><div class="timeline-year">{year}</div><div><h3>{title}</h3><p>{detail}</p></div></article>)}</div><a class="text-link" href="/research/">View research <span aria-hidden="true">→</span></a></div></section>
    <section class="section capabilities"><div class="page"><div class="section-heading"><h2>Ways I contribute.</h2></div><div class="capability-grid">{[["Product design", "Turn real workflow problems into information architecture, interfaces, and product systems.", "TutPro · ReTrace · Evaly"], ["Frontend engineering", "Build adaptive application interfaces that remain usable across devices and complex workflows.", "React · JavaScript · TypeScript · HTML · CSS"], ["Backend & systems", "Design data boundaries, synchronization flows, authentication, and infrastructure.", "Supabase · APIs · Automation"], ["Algorithms & computation", "Apply structured problem solving, mathematical modelling, and competitive-programming thinking.", "C++ · Python · Pascal · DFT"], ["Hardware & native systems", "Connect native interfaces with Bluetooth, sensors, and hardware protocols.", "GalaxyBar · Robotics"], ["Design & visual systems", "Create interface systems, prototypes, and spatial concepts with visual clarity.", "Figma · Blender"]].map(([title, description, evidence]) => <div class="capability" data-reveal><h3>{title}</h3><p>{description}</p><small>{evidence}</small></div>)}</div></div></section>
    <section class="section about"><div class="page"><div class="about-inner"><div class="eyebrow">Teaching & community</div><h2>Education is a product problem I know from the inside.</h2><p>Alongside building products, I teach English remotely and provide volunteer language support for Ukrainian refugees in Ireland. Earlier, I built and managed a 15,000-member online community, including moderation, onboarding, recruitment, and bot automation.</p><a class="text-link" href="/about/">More about my work <span aria-hidden="true">→</span></a></div></div></section>
    <section class="section contact"><div class="page"><div class="eyebrow">Contact / open to interesting work</div><h2>Let's build something useful.</h2><p class="contact-copy">Product, engineering, research, education, or something difficult enough to be interesting.</p><div class="contact-links"><a href={socials.email}>Email ↗</a><a href={socials.telegram}>Telegram ↗</a><a href={socials.instagram}>Instagram ↗</a><a href={socials.github}>GitHub ↗</a><a href={socials.cv}>CV ↗</a></div></div></section></main>
  <footer class="page footer"><span>Artem Kachan · Kyiv, Ukraine</span><div><a href="/work/">Work</a> · <a href="/research/">Research</a> · <a href="/about/">About</a> · <a href={socials.cv}>CV ↗</a></div><span>© 2026 · Astro · GSAP</span></footer>
  <script>
    import { gsap } from "gsap"; import { ScrollTrigger } from "gsap/ScrollTrigger"; gsap.registerPlugin(ScrollTrigger);
    const presentation = document.querySelector<HTMLElement>("[data-presentation]");
    const slideQuery = window.matchMedia("(min-width: 768px)");
    if (presentation && slideQuery.matches) {
      const slides = gsap.utils.toArray<HTMLElement>("[data-slide]", presentation);
      const counter = presentation.querySelector<HTMLElement>("[data-counter]");
      let active = 0;
      const show = (next: number, immediate = false) => { const target = (next + slides.length) % slides.length; if (target === active && !immediate) return; if (immediate) { gsap.set(slides, { autoAlpha: 0, x: 0 }); gsap.set(slides[target], { autoAlpha: 1 }); } else { gsap.to(slides[active], { autoAlpha: 0, x: target > active ? -28 : 28, duration: .24, ease: "power2.in" }); gsap.fromTo(slides[target], { autoAlpha: 0, x: target > active ? 28 : -28 }, { autoAlpha: 1, x: 0, duration: .42, ease: "power3.out" }); } active = target; if (counter) counter.textContent = `${active + 1} / ${slides.length}`; };
      const activate = (start: number) => { show(start, true); document.documentElement.classList.add("deck-mode"); presentation.querySelector<HTMLElement>("[data-next]")?.focus(); };
      const exit = () => { document.documentElement.classList.remove("deck-mode"); gsap.set(slides, { clearProps: "all" }); };
      gsap.set(slides.slice(1), { autoAlpha: 0 });
      document.querySelector("[data-enter-next]")?.addEventListener("click", () => activate(0));
      document.querySelector("[data-enter-prev]")?.addEventListener("click", () => activate(slides.length - 1));
      presentation.querySelector("[data-next]")?.addEventListener("click", () => show(active + 1));
      presentation.querySelector("[data-prev]")?.addEventListener("click", () => show(active - 1));
      presentation.querySelector("[data-exit]")?.addEventListener("click", exit);
      document.addEventListener("keydown", event => { if (!document.documentElement.classList.contains("deck-mode")) return; if (event.key === "ArrowRight") show(active + 1); if (event.key === "ArrowLeft") show(active - 1); if (event.key === "Escape") exit(); });
    }
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches; const header = document.querySelector("[data-header]"); ScrollTrigger.create({ start: 16, onToggle: self => header?.classList.toggle("is-scrolled", self.isActive) });
    if (!reduced) { const title = document.querySelector("[data-hero-title]"); const intro = document.querySelectorAll("[data-hero-meta], [data-hero-copy], [data-hero-link]"); gsap.set([title, ...intro], { y: 20, opacity: 0 }); gsap.timeline({ defaults: { ease: "power3.out" } }).to(title, { y: 0, opacity: 1, duration: .65 }).to(intro, { y: 0, opacity: 1, duration: .38, stagger: .07 }, "-=.35"); gsap.utils.toArray<HTMLElement>("[data-project], [data-reveal], [data-timeline-item]").forEach(item => gsap.from(item, { y: 20, opacity: 0, duration: .55, ease: "power3.out", scrollTrigger: { trigger: item, start: "top 84%", once: true } })); const mm = gsap.matchMedia(); mm.add("(hover: hover) and (pointer: fine)", () => { gsap.utils.toArray<HTMLElement>("[data-project]").forEach(project => { const media = project.querySelector(".project-media"); project.addEventListener("pointerenter", () => gsap.to(media, { y: -5, duration: .28, ease: "power2.out" })); project.addEventListener("pointerleave", () => gsap.to(media, { y: 0, duration: .35, ease: "power2.out" })); }); }); }
  </script>
</BaseLayout>
