---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/global.css";
import { projects, socials } from "../data/projects";
const featured = projects.filter((project) => project.featured);
const metrics = [["7,500+", "students"], ["26,000+", "lesson-hours"], ["490,000+", "study cards"], ["6,350+", "assessments"]];
---
<BaseLayout title="Artem Kachan - Product, Engineering & Research" description="Portfolio of Artem Kachan, a software developer and educational technologist building products across EdTech, AI, systems engineering, and research.">
  <a class="skip" href="#content">Skip to content</a>
  <header class="site-header" data-header><nav class="page nav" aria-label="Primary navigation"><a class="mark" href="#top">artem.</a><div class="nav-links"><a class="nav-link" href="#work">Work</a><a class="nav-link" href="#research">Research</a><a class="nav-link" href="/about/">About</a><a class="nav-link" href={socials.cv}>CV ↗</a><a class="nav-link" href={socials.github}>GitHub ↗</a></div></nav></header>
  <main id="content"><div class="page" id="top"><section class="hero" aria-labelledby="hero-title"><div class="hero-copy"><div class="eyebrow" data-hero-meta>Product · Engineering · Research</div><h1 id="hero-title" data-hero-title>I design and build systems for how people learn, reason, and work.</h1><p data-hero-copy>I'm Artem Kachan, a software developer and educational technologist from Kyiv working across product engineering, EdTech, research, and applied AI.</p><a class="text-link" href="#work" data-hero-link>Explore selected work <span aria-hidden="true">↓</span></a></div><div class="grid-visual" aria-hidden="true"><i class="grid-point"></i></div></section><section class="evidence" aria-label="Selected impact">{metrics.map(([number, label]) => <div><strong>{number}</strong><span>{label}</span></div>)}</section></div>
    <section class="section work" id="work"><div class="page"><div class="section-heading"><div class="eyebrow">Selected work</div><h2>Products with real operating context.</h2></div>{featured.map((project) => <article class:list={["project", project.slug === "tutpro" && "project--flagship"]} data-project><div class="project-meta"><div class="project-number">{project.number}</div><p>{project.label}</p></div><div class="project-content"><h3 class="project-title"><a href={`/work/${project.slug}/`}>{project.name}</a></h3><p class="project-description">{project.description}</p><div class="project-facts">{project.areas.map(area => <span>{area}</span>)}</div><a class:list={["project-media", `visual-${project.visual}`]} href={`/work/${project.slug}/`} aria-label={`Read about ${project.name}`}>{project.image ? <img src={project.image} width="1660" height="916" loading="lazy" alt={`${project.name} interface`} /> : <div class="system-visual" aria-hidden="true"><span></span><span></span><span></span></div>}</a>{project.metrics && <div class="project-metrics">{project.metrics.map(metric => <span>{metric}</span>)}</div>}</div></article>)}</div></section>
    <section class="section impact"><div class="page"><div class="section-heading"><div class="eyebrow">Impact / selected numbers</div><h2>Deployed systems, not portfolio exercises.</h2></div><div class="impact-grid">{[["7,500+", "students reached through TutPro"], ["26,000+", "academic lesson-hours supported"], ["490,000+", "flashcards used through the ecosystem"], ["6,350+", "assessments conducted through Evaly"], ["15,000+", "members in an earlier online community"]].map(([number, label]) => <div data-reveal><strong>{number}</strong><span>{label}</span></div>)}</div></div></section>
    <section class="section index"><div class="page index-grid"><div><div class="section-heading"><h2>Work index</h2></div><ol class="index-list">{projects.map(project => <li><a href={`/work/${project.slug}/`} data-index-row><span class="project-number">{project.number}</span><strong>{project.name}</strong><span class="meta">{project.label}</span></a></li>)}</ol></div><aside class="index-aside"><p>Seven projects across education, native software, mathematical computation, finance, and interactive learning.</p></aside></div></section>
    <section class="section recognition" id="research"><div class="page"><div class="section-heading"><div class="eyebrow">Selected recognition</div><h2>Research, competition, and public work.</h2></div><div class="timeline" data-timeline>{[["2026", "AdventureX 2026 Hackathon", "Selected participant and app developer. Selected from 6,000+ international applicants."], ["2026", "3DevIT International Competition", "2nd place."], ["2025-2026", "Ukrainian Junior Informatics Olympiad", "Winner of stages 1-3."], ["2025", "Junior Academy of Sciences Informatics Olympiad", "Regional prize-winning participant."], ["2024", "National Mathematics Olympiad, Team Competition", "Prize-winning participant."]].map(([year, title, detail]) => <article class="timeline-item" data-timeline-item><div class="timeline-year">{year}</div><div><h3>{title}</h3><p>{detail}</p></div></article>)}</div><a class="text-link" href="/research/">View research <span aria-hidden="true">→</span></a></div></section>
    <section class="section capabilities"><div class="page"><div class="section-heading"><h2>Ways I contribute.</h2></div><div class="capability-grid">{[["Product design", "Turn real workflow problems into information architecture, interfaces, and product systems.", "TutPro · ReTrace · Evaly"], ["Frontend engineering", "Build adaptive application interfaces that remain usable across devices and complex workflows.", "React · JavaScript · TypeScript · HTML · CSS"], ["Backend & systems", "Design data boundaries, synchronization flows, authentication, and infrastructure.", "Supabase · APIs · Automation"], ["Algorithms & computation", "Apply structured problem solving, mathematical modelling, and competitive-programming thinking.", "C++ · Python · Pascal · DFT"], ["Hardware & native systems", "Connect native interfaces with Bluetooth, sensors, and hardware protocols.", "GalaxyBar · Robotics"], ["Design & visual systems", "Create interface systems, prototypes, and spatial concepts with visual clarity.", "Figma · Blender"]].map(([title, description, evidence]) => <div class="capability" data-reveal><h3>{title}</h3><p>{description}</p><small>{evidence}</small></div>)}</div></div></section>
    <section class="section about"><div class="page"><div class="about-inner"><div class="eyebrow">Teaching & community</div><h2>Education is a product problem I know from the inside.</h2><p>Alongside building products, I teach English remotely and provide volunteer language support for Ukrainian refugees in Ireland. Earlier, I built and managed a 15,000-member online community, including moderation, onboarding, recruitment, and bot automation.</p><a class="text-link" href="/about/">More about my work <span aria-hidden="true">→</span></a></div></div></section>
    <section class="section contact"><div class="page"><div class="eyebrow">Contact / open to interesting work</div><h2>Let's build something useful.</h2><p class="contact-copy">Product, engineering, research, education, or something difficult enough to be interesting.</p><div class="contact-links"><a href={socials.email}>Email ↗</a><a href={socials.telegram}>Telegram ↗</a><a href={socials.instagram}>Instagram ↗</a><a href={socials.github}>GitHub ↗</a><a href={socials.cv}>CV ↗</a></div></div></section></main>
  <footer class="page footer"><span>Artem Kachan · Kyiv, Ukraine</span><div><a href="/work/">Work</a> · <a href="/research/">Research</a> · <a href="/about/">About</a> · <a href={socials.cv}>CV ↗</a></div><span>© 2026 · Astro · GSAP</span></footer>
  <script>
    import { gsap } from "gsap"; import { ScrollTrigger } from "gsap/ScrollTrigger"; gsap.registerPlugin(ScrollTrigger);
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches; const header = document.querySelector("[data-header]"); ScrollTrigger.create({ start: 16, onToggle: self => header?.classList.toggle("is-scrolled", self.isActive) });
    if (!reduced) { const title = document.querySelector("[data-hero-title]"); const intro = document.querySelectorAll("[data-hero-meta], [data-hero-copy], [data-hero-link]"); gsap.set([title, ...intro], { y: 20, opacity: 0 }); gsap.timeline({ defaults: { ease: "power3.out" } }).to(title, { y: 0, opacity: 1, duration: .65 }).to(intro, { y: 0, opacity: 1, duration: .38, stagger: .07 }, "-=.35"); gsap.utils.toArray<HTMLElement>("[data-project], [data-reveal], [data-timeline-item]").forEach(item => gsap.from(item, { y: 20, opacity: 0, duration: .55, ease: "power3.out", scrollTrigger: { trigger: item, start: "top 84%", once: true } })); const mm = gsap.matchMedia(); mm.add("(hover: hover) and (pointer: fine)", () => { gsap.utils.toArray<HTMLElement>("[data-project]").forEach(project => { const media = project.querySelector(".project-media"); project.addEventListener("pointerenter", () => gsap.to(media, { y: -5, duration: .28, ease: "power2.out" })); project.addEventListener("pointerleave", () => gsap.to(media, { y: 0, duration: .35, ease: "power2.out" })); }); }); }
  </script>
</BaseLayout>
