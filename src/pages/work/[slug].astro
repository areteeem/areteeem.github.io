---
import BaseLayout from "../../layouts/BaseLayout.astro";
import "../../styles/global.css";
import { projects } from "../../data/projects";

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props;
---

<BaseLayout title={`${project.name} | Artem`} description={project.description}>
  <a class="skip" href="#content">Skip to content</a>
  <header class="site-header is-scrolled">
    <nav class="page nav" aria-label="Primary navigation"><a class="mark" href="/" aria-label="Artem Kachan, home">Artem K.</a><div class="nav-links"><a class="nav-link" href="/#work">Work</a><a class="nav-link" href="/#about">About</a><a class="nav-link" href="https://github.com/areteeem">GitHub</a></div></nav>
  </header>
  <main id="content" class="page">
    <article class="case-study section">
      <a class="text-link" href="/#work">← Back to work</a>
      <div class="section-heading" style="margin-top: 4rem"><div class="eyebrow">{project.label}</div><h1 class="case-title">{project.name}</h1><p class="case-lede">{project.description}</p>{project.externalUrl && <a class="text-link" href={project.externalUrl} target="_blank" rel="noreferrer">Visit tutpro.org <span aria-hidden="true">↗</span></a>}</div>
      {project.image && <figure class="case-media"><img src={project.image} width="1600" height="1200" loading="eager" decoding="async" alt={`${project.name} interface`} /><figcaption>{project.role}</figcaption></figure>}
      <div class="case-content">
        <section><h2>Problem</h2><p>{project.problem}</p></section>
        <section><h2>Approach</h2><p>{project.approach}</p></section>
        <section><h2>Technical architecture</h2><p>{project.architecture}</p></section>
        <section><h2>Current result</h2><p>{project.result}</p></section>
      </div>
    </article>
  </main>
  <footer class="page footer"><span>© {new Date().getFullYear()} Artem</span><a href="/">Home</a></footer>
</BaseLayout>
